// tack macOS app icon: white squircle tile + pushpin glyph.
//
// A flat pushpin (a tack!) in Ferris orange (#F74C00): domed head, a
// capsule brim at its base, and a tapered pin, tilted 35° like the 📌
// emoji. Transparent canvas so the rounded corners show.
//
// Build: lini --static assets/app-icon.lini -o assets/app-icon.svg
// Raster: resvg -w 1024 assets/app-icon.svg assets/app-icon.png
{
  layout: stack; padding: 0; fill: none;
  --ferris: #F74C00;
}

|rect#tile| { width: 320; height: 320; radius: 70; fill: white; stroke: none; }
|path#pin| {
  fill: --ferris; stroke: none; rotate: 35; translate: -4 6;
  path: "M -87.9 -76.9 A 89.9 89.9 0 0 1 87.9 -76.9 L 89.9 -76.9 A 18.9 18.9 0 0 1 89.9 -39.2 L 17.4 -39.2 L 0 127.6 L -17.4 -39.2 L -89.9 -39.2 A 18.9 18.9 0 0 1 -89.9 -76.9 Z";
}
